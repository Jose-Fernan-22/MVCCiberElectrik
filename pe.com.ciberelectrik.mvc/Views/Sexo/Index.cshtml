@model IEnumerable<pe.com.ciberelectrik.mvc.Models.Sexo>

@{
    ViewBag.Title = "Listar Sexo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*contenedor*@
<div class="container mt-4">
    @*inicio dek card*@
    <div class="card shadow border-0">
        @*cabecera del card*@
        <div class="card-header bg-dark text-white d-flex justify-content-between aling-items-center">
            <h4 class="mb-0">Listado de Sexos</h4>
            @Html.ActionLink("Registrar Sexo", "Create", null, new { @class = "btn btn-primary bi bi-plus-circle-fill" })
        </div>
        @*fin de la cabecera del card*@

        @*incio del body del card*@
        <div class="card-body">
            <div class="mb-3">
                <span class="badge bg-secondary">
                    Total de Registros : @Model.Count()
                </span>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                Codigo
                            </th>
                            <th>
                                Nombre
                            </th>
                            <th>
                                Estado
                            </th>
                            <th>
                                Acciones
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.codigo, null, new { @class = "text-center" })
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.nombre, null, new { @class = "text-center" })
                                </td>
                                <td>
                                    @if (item.estado)
                                    {
                                        <span class="badge bg-success">Habilitado</span>

                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deshabilitado</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @Html.ActionLink("Actualizar", "Edit", new { id = item.codigo }, new { @class = "btn btn-success btn-sm bi bi-pencil-square me-1" })
                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.codigo }, new { @class = "btn btn-danger btn-sm bi bi-trash-fill me-1" })
                                    @Html.ActionLink("Habilitar", "Enable", new { id = item.codigo }, new { @class = "btn btn-warning btn-sm bi bi-check-circle-fill me-1" })
                                    @Html.ActionLink("Ver Detalle", "Details", new { id = item.codigo }, new { @class = "btn btn-dark btn-sm bi bi-eye-fill me-1" })
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
        @*fin del cuerpo del card*@
        @*inicio del footer del card*@
        <div class="card-footer text-muted text-center">
            CiberElectrik  Sexos - Todos los derechos reservados &copy; @DateTime.Now.Year
        </div>
        @*fin del footer del card*@
    </div>
    @*fin del card*@
</div>
@*fin del contenedor*@
