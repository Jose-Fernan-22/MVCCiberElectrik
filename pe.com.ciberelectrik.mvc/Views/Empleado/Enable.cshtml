@model pe.com.ciberelectrik.mvc.Models.Empleado

@{
    ViewBag.Title = "Habilitar Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0">Habilitar Registro de Empleado</h4>
        </div>

        <div class="card-body">
            @* Alerta visual informativa *@
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="bi bi-shield-check fs-4 me-3"></i>
                <div>
                    <strong>Restaurar Acceso:</strong> ¿Está seguro que desea habilitar a este empleado?
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mb-3 mt-4">Datos del Empleado a Habilitar</h5>

            <div class="row mb-2">
                <div class="col-md-3 fw-bold">Código:</div>
                <div class="col-md-9">@Model.codigo</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3 fw-bold">Empleado:</div>
                <div class="col-md-9">@Model.nombre @Model.apellidopaterno @Model.apellidomaterno</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3 fw-bold">Rol / Cargo:</div>
                <div class="col-md-9">@Model.rol.nombre</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3 fw-bold">Documento:</div>
                <div class="col-md-9">@Model.tipodocumento.nombre - @Model.documento</div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3 fw-bold">Usuario de Sistema:</div>
                <div class="col-md-9"><span class="badge bg-light text-dark font-monospace">@Model.usuario</span></div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3 fw-bold">Estado Actual:</div>
                <div class="col-md-9">
                    @if (Model.estado)
                    {
                        <span class="badge bg-success">Habilitado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Deshabilitado</span>
                    }
                </div>
            </div>

            @* Formulario para enviar la petición POST de habilitación *@
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between border-top pt-3">
                    @Html.ActionLink("Cancelar y Regresar", "Index", null, new { @class = "btn btn-dark" })
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-circle-fill"></i> Confirmar Habilitación
                    </button>
                </div>
            }
        </div>

        <div class="card-footer text-muted text-center">
            CiberElectrik Empleados - Todos los derechos reservados &copy; @DateTime.Now.Year
        </div>
    </div>
</div>