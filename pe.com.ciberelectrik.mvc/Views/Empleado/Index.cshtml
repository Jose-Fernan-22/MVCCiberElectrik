@model IEnumerable<pe.com.ciberelectrik.mvc.Models.Empleado>

@{
    ViewBag.Title = "REgistrar Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*contenedor*@
<div class="container mt-4">
    @*inicio del card*@
    <div class="card shadow border-0">
        @*cabecera del card*@
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Listado de Empleados</h4>
            @Html.ActionLink("Registrar Empleado", "Create", null, new { @class = "btn btn-primary bi bi-plus-circle-fill" })
        </div>
        @*fin de la cabecera del card*@

        @*incio del body del card*@
        <div class="card-body">
            <div class="mb-3">
                <span class="badge bg-secondary">
                    Total de Registros : @Model.Count()
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="table-dark text-center">
                        <tr>
                            <th style="width:5%">Código</th>
                            <th style="width:20%">Empleado</th>
                            <th style="width:10%">Rol</th>
                            <th style="width:10%">Documento</th>
                            <th style="width:10%">Celular</th>
                            <th style="width:15%">Correo</th>
                            <th style="width:5%">Estado</th>
                            <th style="width:25%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle text-center">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.codigo)
                                </td>
                                <td class="text-start">
                                    @item.nombre @item.apellidopaterno @item.apellidomaterno
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.rol.nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.documento)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.celular)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.correo)
                                </td>
                                <td>
                                    @if (item.estado)
                                    {
                                        <span class="badge bg-success">Habilitado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deshabilitado</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @Html.ActionLink("Actualizar", "Edit", new { id = item.codigo }, new { @class = "btn btn-success btn-sm bi bi-pencil-square me-1" })
                                        @Html.ActionLink("Eliminar", "Delete", new { id = item.codigo }, new { @class = "btn btn-danger btn-sm bi bi-pencil-square me-1" })
                                        @Html.ActionLink("Habilitar", "Enable", new { id = item.codigo }, new { @class = "btn btn-warning btn-sm bi bi-pencil-square me-1" })
                                        @Html.ActionLink("Ver Detalle", "Details", new { id = item.codigo }, new { @class = "btn btn-dark btn-sm bi bi-pencil-square me-1" })
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @*fin del cuerpo del card*@

        @*inicio del footer del card*@
        <div class="card-footer text-muted text-center">
            CiberElectrik Empleados - Todos los derechos reservados &copy; @DateTime.Now.Year
        </div>
        @*fin del footer del card*@
    </div>
    @*fin del card*@
</div>
@*fin del contenedor*@