@model pe.com.ciberelectrik.mvc.Models.Cliente

@{
    ViewBag.Title = "Detalle de Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*contenedor*@
<div class="container mt-4">
    @*inicio del card*@
    <div class="card shadow border-0">
        @*cabecera del card*@
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Detalle de Cliente</h4>
        </div>
        @*fin de la cabecera del card*@

        @*inicio del body del card*@
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Código</strong>
                </div>
                <div class="col-md-9">
                    @Model.codigo
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Nombre Completo</strong>
                </div>
                <div class="col-md-9">
                    @Model.nombre @Model.apellidopaterno @Model.apellidomaterno
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Tipo de Documento</strong>
                </div>
                <div class="col-md-9">
                    @Model.tipodocumento.nombre
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Documento</strong>
                </div>
                <div class="col-md-9">
                    @Model.documento
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Sexo</strong>
                </div>
                <div class="col-md-9">
                    @Model.sexo.nombre
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Dirección</strong>
                </div>
                <div class="col-md-9">
                    @Model.direccion
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Distrito</strong>
                </div>
                <div class="col-md-9">
                    @Model.distrito.nombre
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Teléfono Fijo</strong>
                </div>
                <div class="col-md-9">
                    @Model.telefono
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Celular</strong>
                </div>
                <div class="col-md-9">
                    @Model.celular
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <strong>Correo Electrónico</strong>
                </div>
                <div class="col-md-9">
                    @Model.correo
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <strong>Estado</strong>
                </div>
                <div class="col-md-9">
                    @if (Model.estado)
                    {
                        <span class="badge bg-success">Habilitado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Deshabilitado</span>
                    }
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between">
                    @Html.ActionLink("Actualizar", "Edit", new { id = Model.codigo }, new { @class = "btn btn-success" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = Model.codigo }, new { @class = "btn btn-danger" })
                    @Html.ActionLink("Habilitar", "Enable", new { id = Model.codigo }, new { @class = "btn btn-warning" })
                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                </div>
            }

        </div>
        @*fin del cuerpo del card*@

        @*inicio del footer del card*@
        <div class="card-footer text-muted text-center">
            CiberElectrik Clientes - Todos los derechos reservados &copy; @DateTime.Now.Year
        </div>
        @*fin del footer del card*@
    </div>
    @*fin del card*@
</div>
@*fin del contenedor*@