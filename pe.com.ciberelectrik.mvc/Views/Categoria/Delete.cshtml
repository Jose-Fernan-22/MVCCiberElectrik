@model pe.com.ciberelectrik.mvc.Models.Categoria

@{
    ViewBag.Title = "Eliminacion de Categoria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*contenedor*@
<div class="container mt-4">
    @*inicio dek card*@
    <div class="card shadow border-0">
        @*cabecera del card*@
        <div class="card-header bg-danger text-white d-flex justify-content-between aling-items-center">
            <h4 class="mb-0">Eliminacion de Categorias</h4>
        </div>
        @*fin de la cabecera del card*@

        @*incio del body del card*@
        <div class="card-body">
            <div class="alert alert-danger">
                ¿ Estás seguro que deseas eliminar el siguiente registro?
            </div>
            <div class="mb-3">
                <div class="col-md-3">
                    <strong>Código</strong>
                </div>
                <div class="col-md-9">
                    @Model.codigo
                </div>
            </div>
            <div class="mb-3">
                <div class="col-md-3">
                    <strong>Nombre</strong>
                </div>
                <div class="col-md-9">
                    @Model.nombre
                </div>
            </div>
            <div class="mb-4">
                <div class="col-md-3">
                    <strong>Estado</strong>
                </div>
                <div class="col-md-9">
                    @if (Model.estado)
                    {
                        <span class="badge bg-success">Habilitado</span>

                    }
                    else
                    {
                        <span class="badge bg-danger">Deshabilitado</span>
                    }
                </div>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-danger">Eliminar Categoria</button>
                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-dark" })
                </div>
            }

        </div>
        @*fin del cuerpo del card*@
        @*inicio del footer del card*@
    <div class="card-footer text-muted text-center">
        CiberElectrik - Categorias - Todos los derechos reservados &copy; @DateTime.Now.Year
    </div>
        @*fin del footer del card*@
    </div>
    @*fin del card*@
</div>
@*fin del contenedor*@